{
  "name": "pgapi",
  "version": "0.0.0-alpha9",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "local": "bun run src/index.ts --connection-string postgres://postgres:postgres@localhost:5432/postgres --schema public --console --jwt-secret a-string-secret-at-least-256-bits-long",
    "embed-assets": "bun scripts/embed-assets.ts",
    "build": "bun run embed-assets && bun build src/index.ts --compile --outfile pgapi",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'src/{integration,permissions}.test.ts'",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "fp-ts": "^2.16.11",
    "graphiql": "3.5.0",
    "graphql": "^17.0.2",
    "io-ts": "^2.2.22",
    "pg": "^8.22.0",
    "react": "18",
    "react-dom": "18"
  }
}
